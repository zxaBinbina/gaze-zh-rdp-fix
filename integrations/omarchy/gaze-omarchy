set -eu

PLUGIN_ID=com.gundulabs.gaze.lock
SOURCE=/usr/share/gaze/omarchy
HOST=/usr/share/omarchy
PAM_FILE=/etc/pam.d/gaze-omarchy-face
PLUGIN_LINK="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$PLUGIN_ID"

usage() {
	cat <<'HELP'
用法：gaze-omarchy enable|disable|doctor|ready

enable   从已解锁的 Omarchy 桌面启用 Gaze 锁屏插件。
disable  删除集成软件包前恢复原版锁屏。
doctor   报告主程序兼容性、PAM、录入和锁屏就绪状态。
ready    静默检查人脸认证就绪状态，不打开摄像头。

请以桌面用户身份运行，不要使用 sudo。
HELP
}

fail() {
	printf 'Gaze Omarchy: %s\n' "$*" >&2
	exit 1
}

run() {
	timeout --kill-after=1s 8s "$@"
}

compatible() {
	[ -r "$SOURCE/upstream-lock.json" ] || return 1
	jq -e '.profiles | type == "array" and length > 0 and
		all(.[]; (.sha256 | type) == "object" and (.sha256 | length) > 0)' \
		"$SOURCE/upstream-lock.json" >/dev/null || return 1
	profiles=$(jq -er '.profiles | keys[]' "$SOURCE/upstream-lock.json") || return 1
	for profile in $profiles; do
		if jq -er --argjson profile "$profile" \
			'.profiles[$profile].sha256 | to_entries[] | [.value, .key] | @tsv' \
			"$SOURCE/upstream-lock.json" |
			while read -r digest relative_path; do
				[ -f "$HOST/$relative_path" ] || exit 1
				actual=$(sha256sum <"$HOST/$relative_path") || exit 1
				[ "${actual%% *}" = "$digest" ] || exit 1
			done; then
			return 0
		fi
	done
	return 1
}

trusted_file() {
	[ -f "$1" ] || return 1
	trusted_path=$1
	while :; do
		[ ! -L "$trusted_path" ] || return 1
		owner=$(stat -c '%u' "$trusted_path") || return 1
		mode=$(stat -c '%a' "$trusted_path") || return 1
		[ "$owner" = 0 ] && [ "$((0$mode & 022))" -eq 0 ] || return 1
		[ "$trusted_path" != / ] || break
		trusted_path=$(dirname "$trusted_path")
	done
}

pam_ready() {
	trusted_file "$PAM_FILE" || return 1
	rules=$(awk 'NF && $1 !~ /^#/ { $1=$1; print }' "$PAM_FILE") || return 1
	[ "$rules" = 'auth requisite pam_nologin.so
auth requisite pam_faillock.so preauth
auth sufficient pam_gaze.so
auth required pam_deny.so
account required pam_nologin.so
account required pam_unix.so
password required pam_deny.so' ]
}

owns_link() {
	[ -L "$PLUGIN_LINK" ] && [ "$(readlink "$PLUGIN_LINK")" = "$SOURCE" ]
}

enrolled() {
	current_user=$(id -un) || return 1
	result=$(run /usr/bin/busctl --system --timeout=2s call \
		com.gundulabs.Gaze /com/gundulabs/Gaze com.gundulabs.Gaze \
		HasEnrolledFaces s "$current_user") || return 1
	[ "$result" = 'b true' ]
}

unlocked_status() {
	status=$(run omarchy-shell lock status) || fail '无法查询 Omarchy 锁屏。'
	printf '%s\n' "$status" | jq -e '.locked == false and .passwordPam == true' >/dev/null ||
		fail '请先解锁桌面，并恢复正常的密码认证。'
}

enable_plugin() {
	unlocked_status
	compatible || fail '此 Omarchy 版本需要审核。受支持的基准版本为 4.0.2 和 4.0.3。'
	pam_ready || fail '请重新安装 gaze-omarchy：其专用人脸 PAM 服务缺失或已被修改。'
	catalog=$(run omarchy-plugin-catalog) || fail '无法查询 Omarchy 插件目录。'
	printf '%s\n' "$catalog" | jq -e 'type == "array"' >/dev/null || fail '插件目录无效。'
	if printf '%s\n' "$catalog" | jq -e --arg id "$PLUGIN_ID" \
		'any(.[]; .enabled == true and (.clonedFrom // .omarchy.clonedFrom) == "omarchy.lock" and .id != $id)' >/dev/null; then
		fail '启用 Gaze 前，请先禁用其他自定义锁屏插件。'
	fi
	if [ -e "$PLUGIN_LINK" ] || [ -L "$PLUGIN_LINK" ]; then
		owns_link || fail "保留现有插件目录：$PLUGIN_LINK"
	else
		mkdir -p "$(dirname "$PLUGIN_LINK")"
		ln -s "$SOURCE" "$PLUGIN_LINK"
	fi
	run omarchy plugin enable "$PLUGIN_ID" || fail '启用插件失败。运行 gaze-omarchy disable 以恢复原版锁屏。'
	# Recheck before restarting an authentication service.
	unlocked_status
	run omarchy restart shell || fail '请在解锁状态下重启 Omarchy shell 以加载插件。'
	printf 'Gaze Omarchy 锁屏已启用。使用 gaze add-face default 录入，然后运行 gaze auth。\n'
}

wait_for_stock() {
	remaining=10
	while [ "$remaining" -gt 0 ]; do
		if status=$(timeout --kill-after=1s 1s omarchy-shell lock status 2>/dev/null) &&
			printf '%s\n' "$status" | jq -e --arg id "$PLUGIN_ID" \
				'.pluginId != $id and .passwordPam == true' >/dev/null; then
			return 0
		fi
		remaining=$((remaining - 1))
		sleep 0.2
	done
	return 1
}

disable_plugin() {
	if [ ! -e "$PLUGIN_LINK" ] && [ ! -L "$PLUGIN_LINK" ]; then
		printf '当前用户未安装 Gaze Omarchy。\n'
		return 0
	fi
	unlocked_status
	owns_link || fail '没有由软件包管理的 Gaze 插件链接；保留现有目录。'
	run omarchy plugin disable "$PLUGIN_ID" || fail '无法禁用 Gaze；已保留插件链接。'
	run omarchy plugin enable omarchy.lock || fail '无法启用原版锁屏；已保留插件链接。'
	unlocked_status
	run omarchy restart shell || fail '删除 gaze-omarchy 前，请在解锁状态下重启 shell。'
	wait_for_stock || fail '原版锁屏尚未加载；已保留 Gaze 插件链接。'
	rm "$PLUGIN_LINK"
	printf "已恢复 Omarchy 原版锁屏。Gaze 录入数据已保留。\n"
}

issue() {
	printf '%s\n' "$*"
	doctor_failed=1
}

doctor() {
	doctor_failed=0
	compatible || issue 'Omarchy 主程序与已审核的基准版本不同；请更新 gaze-omarchy。'
	pam_ready || issue '专用人脸 PAM 缺失、被修改或不可信；请重新安装 gaze-omarchy。'
	enrolled || issue '尚未录入或守护进程不可用；请运行 gaze add-face default 和 gaze auth。'
	owns_link || issue '当前用户未安装插件；请在解锁状态下运行 gaze-omarchy enable。'
	catalog=$(run omarchy-plugin-catalog 2>/dev/null) || catalog=
	printf '%s\n' "$catalog" | jq -e --arg id "$PLUGIN_ID" \
		'any(.[]; .id == $id and .enabled == true)' >/dev/null 2>&1 ||
		issue 'Gaze 插件已禁用或插件目录不可用；请在解锁状态下运行 gaze-omarchy enable。'
	status=$(run omarchy-shell lock status 2>/dev/null) || status=
	expected=$(jq -er '.version' "$SOURCE/manifest.json") || expected=
	printf '%s\n' "$status" | jq -e --arg id "$PLUGIN_ID" --arg version "$expected" \
		'.pluginId == $id and .pluginVersion == $version' >/dev/null 2>&1 ||
		issue '正在运行的锁屏与已安装的 Gaze 不一致；请在解锁状态下运行 gaze-omarchy enable。'
	printf '%s\n' "$status" | jq -e '.passwordPam == true' >/dev/null 2>&1 ||
		issue 'Omarchy 密码 PAM 不可用；请恢复密码解锁。'
	printf '%s\n' "$status" | jq -e '.face == true' >/dev/null 2>&1 ||
		issue '人脸认证尚未就绪；请在录入并重启 shell 后重试。'
	if [ "$doctor_failed" -eq 0 ]; then
		printf 'Gaze Omarchy 集成已就绪。\n'
	fi
	return "$doctor_failed"
}

case "${1:-}" in
-h | --help) usage; exit 0 ;;
enable | disable | doctor | ready) action=$1 ;;
*) usage >&2; exit 1 ;;
esac
[ "$#" -eq 1 ] || fail '需要一个操作参数。'
[ "$(id -u)" -ne 0 ] || fail '请以桌面用户身份运行，不要使用 sudo。'
case "$action" in
ready) compatible >/dev/null 2>&1 && pam_ready >/dev/null 2>&1 && enrolled >/dev/null 2>&1 ;;
enable) enable_plugin ;;
disable) disable_plugin ;;
doctor) doctor ;;
esac

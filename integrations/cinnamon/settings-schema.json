{
  "layout": {
    "type": "layout",
    "pages": ["behavior"],
    "behavior": {
      "type": "page",
      "title": "行为",
      "sections": ["face-authentication"]
    },
    "face-authentication": {
      "type": "section",
      "title": "人脸认证",
      "keys": [
        "face-authentication-description",
        "enable-face-authentication",
        "face-retry-mode",
        "max-face-tries"
      ]
    }
  },
  "face-authentication-description": {
    "type": "label",
    "description": "用于解锁此会话的人脸认证。这不会影响登录界面。设置保存在此扩展的配置中。"
  },
  "enable-face-authentication": {
    "type": "switch",
    "default": true,
    "description": "启用人脸认证（锁屏）"
  },
  "face-retry-mode": {
    "type": "combobox",
    "default": "fixed",
    "options": {
      "禁用": "disabled",
      "固定次数": "fixed",
      "无限次": "infinite"
    },
    "description": "人脸重试模式"
  },
  "max-face-tries": {
    "type": "spinbutton",
    "default": 3,
    "min": 2,
    "max": 20,
    "step": 1,
    "description": "人脸尝试次数上限",
    "dependency": "face-retry-mode=fixed"
  }
}

--- /dev/null
+++ b/src/FrameAcknowledgement.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <QSet>
+#include <cstdint>
+#include <limits>
+
+inline void acknowledgeFrames(QSet<uint32_t> &pending, bool &suspended, uint32_t id, uint32_t queueDepth)
+{
+    suspended = queueDepth == std::numeric_limits<uint32_t>::max();
+    if (suspended) {
+        pending.clear();
+        return;
+    }
+    for (auto it = pending.begin(); it != pending.end();) {
+        // RFC1982-style serial comparison, valid for a window smaller than 2^31.
+        if (uint32_t(id - *it) < 0x80000000u) {
+            it = pending.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}

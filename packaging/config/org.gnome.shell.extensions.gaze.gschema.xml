<schemalist>
  <schema id="org.gnome.shell.extensions.gaze" path="/org/gnome/shell/extensions/gaze/">
    <key name="enable-face-authentication" type="b">
      <default>false</default>
      <summary>启用人脸认证</summary>
      <description>
        控制 Gaze GNOME 扩展是否为当前 dconf 配置尝试人脸认证。
      </description>
    </key>

    <key name="max-face-tries" type="i">
      <default>3</default>
      <range min="2" max="20"/>
      <summary>人脸认证尝试次数上限</summary>
      <description>
        当前认证周期中停止人脸认证前允许的失败次数。
      </description>
    </key>

    <key name="face-retry-mode" type="s">
      <choices>
        <choice value="disabled"/>
        <choice value="fixed"/>
        <choice value="infinite"/>
      </choices>
      <default>'fixed'</default>
      <summary>人脸重试模式</summary>
      <description>
        人脸认证重试是禁用、限制为固定次数还是无限次。
      </description>
    </key>
  </schema>
</schemalist>
